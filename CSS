body {
    background: #111;
    color: white;
    text-align: center;
    font-family: Arial;
}

.video-container {
    width: 800px;
    height: 450px;
    overflow: hidden;
    margin: auto;
    border: 2px solid #444;
}

video {
    width: 100%;
    transition: transform 0.2s ease;
    transform-origin: center;
}

.controls {
    margin-top: 20px;
}
